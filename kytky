<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trhání kytek - Diančiny hrátky</title>
    <style>
        body {
            font-family: 'Comic Sans MS', 'Arial Rounded MT Bold', sans-serif;
            background: linear-gradient(to bottom, #d4fc79 0%, #96e6a1 100%);
            text-align: center;
            margin: 0;
            padding: 10px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            height: 94vh;
            user-select: none;
            overflow: hidden;
        }
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: white;
            padding: 8px 15px;
            border-radius: 15px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }
        h1 {
            color: #2c3e50;
            font-size: 1.1rem;
            margin: 0;
        }
        .bouquet-preview {
            font-size: 1.3rem;
            background: #fff3cd;
            padding: 4px 10px;
            border-radius: 10px;
            border: 2px dashed #ffecb5;
        }
        /* Hlavní herní plocha */
        .game-card {
            background: white;
            border-radius: 25px;
            padding: 15px;
            width: 92%;
            max-width: 450px;
            margin: 0 auto;
            box-shadow: 0 8px 20px rgba(0,0,0,0.15);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
        }
        .speaker-btn {
            background: #ff6b6b;
            color: white;
            border: none;
            border-radius: 50%;
            width: 70px;
            height: 70px;
            font-size: 2.2rem;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            transition: transform 0.1s;
        }
        .speaker-btn:active { transform: scale(0.9); }
        
        .hint-text {
            font-size: 0.9rem;
            color: #666;
            margin: 0;
        }

        /* Políčka pro skládání slova */
        .slot-container {
            display: flex;
            justify-content: center;
            gap: 8px;
            min-height: 55px;
            margin: 5px 0;
            flex-wrap: wrap;
        }
        .letter-slot {
            width: 45px;
            height: 50px;
            border: 3px dashed #4dabf7;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            font-weight: bold;
            color: #333;
            background: #f8f9fa;
            cursor: pointer;
        }
        .letter-slot.filled {
            border-style: solid;
            background: #e7f5ff;
            border-color: #339af0;
            color: #1c7ed6;
        }

        /* Výběr písmen (Logo Quiz styl) */
        .pool-container {
            display: flex;
            justify-content: center;
            gap: 8px;
            flex-wrap: wrap;
            margin-top: 5px;
        }
        .letter-tile {
            width: 45px;
            height: 45px;
            background: #fab005;
            color: white;
            font-size: 1.8rem;
            font-weight: bold;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 4px 8px rgba(0,0,0,0.15);
            transition: transform 0.1s, opacity 0.2s;
            border-bottom: 4px solid #e67700;
        }
        .letter-tile:active {
            transform: scale(0.9);
        }
        .letter-tile.used {
            opacity: 0.2;
            pointer-events: none;
            background: #adb5bd;
            border-color: #6c757d;
        }

        .message {
            font-size: 1.2rem;
            height: 25px;
            font-weight: bold;
            color: #2b8a3e;
        }

        /* Přechodová obrazovka / Konec kola */
        .overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.8);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: white;
            z-index: 10;
        }
        .overlay h2 { font-size: 2.3rem; margin-bottom: 5px; }
        .overlay p { font-size: 1.2rem; margin-bottom: 20px; text-align: center; padding: 0 20px; }
        .big-bouquet { font-size: 4.5rem; margin: 10px 0; }
        .btn {
            background: #2b8a3e;
            color: white;
            border: none;
            padding: 12px 25px;
            font-size: 1.4rem;
            border-radius: 15px;
            cursor: pointer;
            font-weight: bold;
            box-shadow: 0 6px 12px rgba(0,0,0,0.3);
        }
        .btn:active { transform: scale(0.95); }
        .hidden { display: none !important; }
        .back-link {
            position: absolute;
            top: 10px;
            left: 10px;
            background: white;
            padding: 6px 12px;
            border-radius: 10px;
            text-decoration: none;
            color: #333;
            font-weight: bold;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            font-size: 0.9rem;
        }
    </style>
</head>
<body>

    <a href="index.html" class="back-link">⬅️ Zpět do menu</a>

    <!-- Úvodní / Koncová obrazovka -->
    <div class="overlay" id="overlayScreen">
        <h2>🌸 Trhání kytek 🌸</h2>
        <p id="overlayText">Poskládej slova, utrhni kytičky a postav ten nejkrásnější puget pro maminku nebo tety!</p>
        <div class="big-bouquet" id="overlayEmoji">🌷🌻🌹</div>
        <button class="btn" id="overlayBtn" onclick="startGame()">Zaít hrát</button>
    </div>

    <header>
        <h1>🌷 Trhání kytek</h1>
        <div class="bouquet-preview" id="bouquetPreview">Puget: <span></span></div>
    </header>

    <div class="game-card">
        <button class="speaker-btn" onclick="speakWord()" title="Přehrát slovo">🔊</button>
        <p class="hint-text">(kliknutím uslyšíš slovo)</p>
        
        <div class="message" id="message">Poskládej slovo z písmen</div>

        <!-- Prázdná políčka pro slovo -->
        <div class="slot-container" id="slotContainer"></div>

        <!-- Výběr písmen -->
        <div class="pool-container" id="poolContainer"></div>
    </div>

    <script>
        // Velká zásoba slov pro prvňáčky
        const wordsList = [
            "PES", "KOČKA", "MÁMA", "TÁTA", "STROM", "LIST", 
            "DŮM", "AUTO", "KOLO", "KVĚT", "SLUNCE", "VODA", 
            "RYBA", "MLÉKO", "CHLÉB", "JABLKO", "HRAD", "PTÁK",
            "OKNO", "MÍČ", "KNIHA", "ŠKOLA", "LÉTO", "ZIMA"
        ];

        let currentRound = 1;
        const totalRounds = 5;
        let activeWord = "";
        let collectedFlowers = [];
        let currentSlots = []; // drží info, co je v jednotlivých políčkách
        let poolLetters = [];  // všechna písmena na výběr

        const overlayEl = document.getElementById('overlayScreen');
        const overlayTitleEl = overlayEl.querySelector('h2');
        const overlayTextEl = document.getElementById('overlayText');
        const overlayBtnEl = document.getElementById('overlayBtn');
        const overlayEmojiEl = document.getElementById('overlayEmoji');
        
        const slotContainerEl = document.getElementById('slotContainer');
        const poolContainerEl = document.getElementById('poolContainer');
        const messageEl = document.getElementById('message');
        const bouquetPreviewEl = document.getElementById('bouquetPreview').querySelector('span');

        const flowerEmojis = ['🌷', '🌻', '🌹', '🌼', '🌸', '🌺', '💐', '🍀'];

        function startGame() {
            currentRound = 1;
            collectedFlowers = [];
            overlayEl.classList.add('hidden');
            nextRound();
        }

        function nextRound() {
            messageEl.textContent = "";
            
            // Vyber náhodné slovo
            activeWord = wordsList[Math.floor(Math.random() * wordsList.length)];
            
            // Inicializuj políčka
            currentSlots = new Array(activeWord.length).fill(null);

            // Připrav písmena pro Logo Quiz (správná + 2-3 špatná navíc)
            let correctLetters = activeWord.split('');
            let alphabet = "ABCČDEFGHIJKLMNOPRSŠTUVXYZŽ";
            let wrongCount = activeWord.length <= 3 ? 2 : 3;
            let wrongLetters = [];

            while(wrongLetters.length < wrongCount) {
                let randomChar = alphabet[Math.floor(Math.random() * alphabet.length)];
                if (!correctLetters.includes(randomChar) && !wrongLetters.includes(randomChar)) {
                    wrongLetters.push(randomChar);
                }
            }

            // Spoj a zamíchej
            poolLetters = [...correctLetters, ...wrongLetters];
            poolLetters.sort(() => Math.random() - 0.5);

            renderGame();
            speakWord();
        }

        function renderGame() {
            // Aktualizuj puget v hlavičce
            bouquetPreviewEl.textContent = collectedFlowers.join(" ");

            // Vykresli sloty pro slovo
            slotContainerEl.innerHTML = "";
            currentSlots.forEach((letter, index) => {
                const slot = document.createElement('div');
                slot.classList.add('letter-slot');
                if (letter) {
                    slot.classList.add('filled');
                    slot.textContent = letter;
                    slot.onclick = () => removeFromSlot(index);
                } else {
                    slot.textContent = "";
                }
                slotContainerEl.appendChild(slot);
            });

            // Vykresli výběr písmen
            poolContainerEl.innerHTML = "";
            poolLetters.forEach((item, poolIndex) => {
                const tile = document.createElement('div');
                tile.classList.add('letter-tile');
                tile.textContent = item.letter || item;
                
                // Zkontroluj, jestli už je tato dlaždice použitá
                if (item.used) {
                    tile.classList.add('used');
                } else {
                    tile.onclick = () => selectTile(poolIndex);
                }
                poolContainerEl.appendChild(tile);
            });
        }

        function speakWord() {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                let utterance = new SpeechSynthesisUtterance(activeWord);
                utterance.lang = 'cs-CZ';
                utterance.rate = 0.75; // Pomaleji pro prvňáčky
                window.speechSynthesis.speak(utterance);
            }
        }

        function selectTile(poolIndex) {
            // Najdi první prázdný slot
            let emptyIndex = currentSlots.indexOf(null);
            if (emptyIndex !== -1) {
                currentSlots[emptyIndex] = poolLetters[poolIndex];
                poolLetters[poolIndex] = { letter: poolLetters[poolIndex], used: true, poolId: poolIndex };
                
                renderGame();

                // Zkontroluj, jestli už je vyplněno celé slovo
                if (!currentSlots.includes(null)) {
                    checkAnswer();
                }
            }
        }

        function removeFromSlot(slotIndex) {
            let removedLetter = currentSlots[slotIndex];
            if (removedLetter) {
                // Vrať písmeno zpět do výběru
                if (typeof removedLetter === 'object') {
                    poolLetters[removedLetter.poolId].used = false;
                } else {
                    // Najdi odpovídající nepoužitou dlaždici v poolu
                    let tileObj = poolLetters.find(p => (p === removedLetter || p.letter === removedLetter) && p.used);
                    if (tileObj) tileObj.used = false;
                }
                currentSlots[slotIndex] = null;
                renderGame();
            }
        }

        function checkAnswer() {
            // Slož slovo ze slotů
            let formedWord = currentSlots.map(s => typeof s === 'object' ? s.letter : s).join('');

            if (formedWord === activeWord) {
                messageEl.textContent = "Správně! Utrhla jsi kytičku! 🌸";
                
                // Přidej náhodnou kytku do pugetu
                let randomFlower = flowerEmojis[Math.floor(Math.random() * flowerEmojis.length)];
                collectedFlowers.push(randomFlower);

                setTimeout(() => {
                    if (currentRound < totalRounds) {
                        currentRound++;
                        nextRound();
                    } else {
                        showFinalVictory();
                    }
                }, 1200);
            } else {
                messageEl.style.color = '#e03131';
                messageEl.textContent = "Takhle to úplně nesedí, zkus to upravit! 🙈";
                setTimeout(() => {
                    messageEl.style.color = '#2b8a3e';
                    messageEl.textContent = "";
                }, 1500);
            }
        }

        function showFinalVictory() {
            overlayEl.classList.remove('hidden');
            overlayTitleEl.textContent = "🏆 Úžasné! Máš hotový puget!";
            overlayTextEl.textContent = `Zvládla jsi všech ${totalRounds} kol a nasbírala nádherné kytičky!`;
            overlayEmojiEl.textContent = collectedFlowers.join(" ");
            overlayBtnEl.textContent = "Hrát znovu";
        }
    </script>

</body>
</html>
